{
  "name": "veneer",
  "private": true,
  "type": "module",
  "description": "Development tooling for the Veneer Claude Code mod. The mod itself needs no build step.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "benchmark": "node tools/benchmark.mjs",
    "benchmark:host": "node tools/host-bench.mjs",
    "build:grammars": "node tools/build-grammars.mjs",
    "build:math": "node tools/build-math.mjs",
    "build:mermaid": "node tools/build-mermaid.mjs",
    "check:themes": "node tools/check-themes.mjs",
    "conformance": "node tools/conformance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p .",
    "validate": "cd /tmp && claude plugin validate \"$OLDPWD\"",
    "test": "cd /tmp && claude plugin test \"$OLDPWD\"",
    "check:ci": "npm run format:check && npm run lint && npm run conformance && npm run validate && npm test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run conformance && npm run validate && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "beautiful-mermaid": "^1.1.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mathjax-full": "^3.2.1",
    "oniguruma-to-es": "^4.3.6",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "tm-grammars": "^1.32.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
