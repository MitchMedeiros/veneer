{
  "name": "veneer",
  "private": true,
  "type": "module",
  "description": "Development tooling for the Veneer Claude Code mod. The mod itself needs no build step.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p .",
    "validate": "cd /tmp && claude plugin validate \"$OLDPWD\"",
    "test": "cd /tmp && claude plugin test \"$OLDPWD\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
