{
  "name": "Claude Code",
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "ansi:green" } },
    {
      "scope": [
        "comment keyword.codetag",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": { "foreground": "ansi:green" }
    },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "ansi:red" } },
    { "scope": ["string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "ansi:red" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "ansi:green" } },
    {
      "scope": [
        "keyword.control",
        "keyword.other",
        "keyword.declaration",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language.this"
      ],
      "settings": { "foreground": "ansi:blue" }
    },
    {
      "scope": ["entity.name.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "ansi:yellow" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type.class", "entity.other.inherited-class"],
      "settings": { "foreground": "ansi:blue" }
    },
    {
      "scope": ["support.function", "support.class", "support.variable", "support.type", "entity.name.type"],
      "settings": { "foreground": "ansi:cyan" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "ansi:gray" }
    },
    { "scope": ["punctuation.definition.tag"], "settings": { "foreground": "ansi:gray" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "ansi:blue" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "ansi:cyan" } },
    {
      "scope": ["support.type.property-name", "entity.name.tag.yaml"],
      "settings": { "foreground": "ansi:cyan" }
    },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "ansi:green" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "ansi:red" } }
  ]
}
